        "message": "<Field> doesn't accept that prop. Declared props: label, children, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Field> size must be one of 'md' | 'sm'."
