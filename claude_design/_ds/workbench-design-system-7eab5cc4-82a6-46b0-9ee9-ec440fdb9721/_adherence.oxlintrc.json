        "message": "<IconButton> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<InlineStatus> doesn't accept that prop. Declared props: children, icon, actionLabel, onAction."
